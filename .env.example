# Telegram API credentials
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash
SESSION=your_telethon_session_string

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# User IDs
SANDY_USER_ID=your_numeric_telegram_user_id
PRIMARY_ADMIN=your_numeric_telegram_user_id

# Optional group replies
# Comma-separated Telegram chat IDs
AI_GROUP_IDS=

# Web server
PORT=8080

# Optional AI voice replies
VOICE_REPLIES=false
VOICE_NAME=hi-IN-SwaraNeural

# Media upload limit in MB
MAX_MEDIA_MB=15
