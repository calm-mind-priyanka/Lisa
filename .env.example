# ==========================================
# TELEGRAM CONFIGURATION (REQUIRED)
# ==========================================

API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash
SESSION=your_fresh_telethon_session_string


# ==========================================
# GOOGLE GEMINI API (REQUIRED)
# ==========================================

GEMINI_API_KEY=your_gemini_api_key


# ==========================================
# ANANYA PERSONALIZATION (REQUIRED)
# ==========================================

# Sandy's numeric Telegram user ID
SANDY_USER_ID=your_numeric_telegram_user_id

# Admin ID; defaults to SANDY_USER_ID if omitted
PRIMARY_ADMIN=your_numeric_telegram_user_id


# ==========================================
# GROUP SETTINGS (OPTIONAL)
# ==========================================

# Comma-separated Telegram group IDs.
# Leave blank to disable AI group replies.
# In enabled groups, Ananya replies only when mentioned
# or when a message replies to her.
AI_GROUP_IDS=

# Comma-separated numeric user IDs to ignore.
# Leave blank if nobody needs to be ignored.
IGNORED_USER_IDS=


# ==========================================
# FREE-TIER GEMINI MODEL PREFERENCE
# ==========================================

# Approved model priority:
# 1. gemini-3.8-flash
# 2. gemini-3.6-flash
# 3. gemini-3.5-flash-lite
# 4. gemini-3.1-flash-lite
#
# Leave blank to automatically select the highest-priority
# available model from the approved list.
#
# Optional: explicitly prefer a model from the approved list.
# GEMINI_MODEL=gemini-3.8-flash


# ==========================================
# VOICE REPLIES (OPTIONAL)
# ==========================================

# Set true to enable generated voice replies.
VOICE_REPLIES=false

# Voice name used for speech generation.
VOICE_NAME=hi-IN-SwaraNeural


# ==========================================
# MEMORY AND MEDIA LIMITS
# ==========================================

# Maximum conversation history turns retained per user.
MAX_HISTORY_TURNS=12

# Maximum image/audio media size in MB.
MAX_MEDIA_MB=15


# ==========================================
# SERVER AND LOGGING
# ==========================================

PORT=8080
LOG_LEVEL=INFO
