# Required: set these in Koyeb Secrets / environment variables.
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash
SESSION=your_fresh_telethon_session_string
GEMINI_API_KEY=your_gemini_api_key
SANDY_USER_ID=your_numeric_telegram_user_id

# Optional. Defaults to SANDY_USER_ID.
PRIMARY_ADMIN=your_numeric_telegram_user_id

# Optional comma-separated Telegram group IDs. Group replies are disabled if blank.
# In enabled groups, Ananya replies only when mentioned or when a message replies to her.
AI_GROUP_IDS=

# Optional comma-separated numeric user IDs to ignore.
IGNORED_USER_IDS=

# Optional model preference. Leave unset/blank to auto-discover models available to your API key.
# GEMINI_MODEL=
VOICE_REPLIES=false
VOICE_NAME=hi-IN-SwaraNeural
MAX_HISTORY_TURNS=12
MAX_MEDIA_MB=15
PORT=8080
LOG_LEVEL=INFO
